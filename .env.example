APP_NAME=Patchbay
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Leave null so the session cookie stays on the dashboard hostname. Widening
# it to ".example.com" would hand the cookie to the WebSocket host too.
SESSION_DOMAIN=null
# Must be true anywhere the dashboard is served over https.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

REVERB_PROVIDER=patchbay
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
PATCHBAY_RELOAD_INTERVAL=2

# --- Dashboard -------------------------------------------------------------
# The hostname the control panel and its landing page answer on. Empty means
# every hostname, which is what a local install wants. Set it to run the
# dashboard on a name of its own while the WebSocket server keeps another:
#   DASHBOARD_DOMAIN=dash.my-ws-server.com
#   PATCHBAY_HOST=ws.my-ws-server.com
DASHBOARD_DOMAIN=
DASHBOARD_BRAND=Patchbay

# The public page at "/". False turns it into a 404 and the deployment says
# nothing at all to anyone who has not been told where to look.
DASHBOARD_LANDING=true
DASHBOARD_LANDING_TAGLINE=
DASHBOARD_DOCS_URL=https://github.com/RobertBoes/patchbay

# Who may sign in, beyond holding valid credentials. Comma-separated; empty
# means every account in the users table.
DASHBOARD_ALLOWED_EMAILS=

# Who sees every application rather than only their own. Comma-separated.
# Applications made with `php artisan patchbay:app` belong to no one, so only
# admins see them in the panel.
DASHBOARD_ADMINS=

# Let anyone sign up. New accounts confirm their address first, so mail has
# to work and a queue worker has to run. Pair with DASHBOARD_QUOTAS.
DASHBOARD_REGISTRATION=false

# Limit everyone but admins: how many applications, and how many connections
# each may hold. Off, every account is unlimited.
DASHBOARD_QUOTAS=false
DASHBOARD_QUOTA_APPS=10
DASHBOARD_QUOTA_CONNECTIONS=10

# Send everyone to set up an authenticator app before they can use the panel.
DASHBOARD_REQUIRE_MFA=false

# The proxies in front of this application, or "*" when nothing else can
# reach it. Needed for the login throttle to see real client addresses.
TRUSTED_PROXIES=
