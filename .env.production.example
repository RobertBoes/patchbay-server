# Production settings for docker-compose.production.yml. Copy to .env beside
# the compose file on the server and fill in everything marked CHANGE.

# The image to run. Pin a tag in production rather than following latest.
PATCHBAY_IMAGE=ghcr.io/robertboes/patchbay-server:latest

APP_NAME=Patchbay
APP_ENV=production
# CHANGE: php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
# CHANGE: the dashboard's own address.
APP_URL=https://dash.example.com

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=patchbay
DB_USERNAME=patchbay
# CHANGE: a long random string.
DB_PASSWORD=

# The database carries sessions, the queue and the cache. The cache is how the
# panel tells the Reverb server about changed applications, so it has to be a
# store both containers share, which the database is.
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=null
QUEUE_CONNECTION=database
CACHE_STORE=database

# CHANGE: registration sends confirmation emails, so mail has to work.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="patchbay@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# The Reverb container listens on 8080 inside the stack; the proxy terminates
# TLS in front of it.
REVERB_PROVIDER=patchbay
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# CHANGE: how clients reach the WebSocket server, as handed out in each
# application's snippets.
REVERB_HOST=ws.example.com
REVERB_PORT=443
REVERB_SCHEME=https

# How the panel reaches the Reverb server's HTTP API: directly, over the
# stack's internal network, not back out through the proxy.
PATCHBAY_SERVER_URL=http://reverb:8080

# CHANGE: the two names the proxy routes (see deploy/caddy/patchbay.caddy).
DASHBOARD_DOMAIN=dash.example.com
DASHBOARD_BRAND=Patchbay
DASHBOARD_LANDING=true
DASHBOARD_LANDING_TAGLINE=
DASHBOARD_LANDING_METRICS=false
DASHBOARD_DOCS_URL=https://github.com/RobertBoes/patchbay

# CHANGE: your own address, so you see every application and are never limited.
DASHBOARD_ADMINS=
DASHBOARD_ALLOWED_EMAILS=
DASHBOARD_REQUIRE_MFA=false

# An open, free service: sign-ups with limits. Leave false for a private one.
DASHBOARD_REGISTRATION=false
DASHBOARD_QUOTAS=false
DASHBOARD_QUOTA_APPS=10
DASHBOARD_QUOTA_CONNECTIONS=10

# The proxy in front is the only thing that reaches the web container.
TRUSTED_PROXIES=*
